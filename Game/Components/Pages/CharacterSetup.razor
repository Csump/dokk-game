@page "/setup"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using Game.Models
@using Game.Services
@using Game.Components.Shared
@using Microsoft.AspNetCore.Components.Forms

@inject GameService GameService
@inject GameState GameState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>HEDGIE Karakterválasztás</PageTitle>

<div class="main-container @($"bg-{CurrentCharacter.Color}")">
    <div class="setup-content">
        <div class="upper-wrapper">
            <h1>Karakterválasztás</h1>
            <p>Válassz egy számodra szimpatikus szereplőt és indulhat is a játék!</p>

            <div class="level-selector">
                <button type="button"
                        class="@(_model.Level == PlayerLevel.Doktorandusz ? "fancy-dark" : "")"
                        @onclick="() => _model.Level = PlayerLevel.Doktorandusz">
                    @FormatEnum(PlayerLevel.Doktorandusz)
                </button>

                <button type="button"
                        class="@(_model.Level == PlayerLevel.Adjunktus ? "fancy-dark" : "")"
                        @onclick="() => _model.Level = PlayerLevel.Adjunktus">
                    @FormatEnum(PlayerLevel.Adjunktus)
                </button>

                <button type="button"
                        class="@(_model.Level == PlayerLevel.Docens ? "fancy-dark" : "")"
                        @onclick="() => _model.Level = PlayerLevel.Docens">
                    @FormatEnum(PlayerLevel.Docens)
                </button>
            </div>
        </div>

        <div class="character-info">
            <div class="character-title">
                <p class="character-name">@CurrentCharacter.Name</p>
                <p class="character-quote">„@CurrentCharacter.Quote”</p>
            </div>

            <p class="character-description">@((MarkupString)CurrentCharacter.Description)</p>
        </div>
    </div>

    <button type="button" class="arrow-button left" @onclick="PrevCharacter">
        ←
    </button>

    <div class="character-shine" />

    <img class="character-image" src="@CurrentCharacter.ImageUrl" alt="Karakterillusztráció" />

    <button type="button" class="arrow-button right" @onclick="NextCharacter">
        →
    </button>

    <PlayerStatsBar Stats="@PreviewStats" />

    <div class="continue-wrapper">
        <button class="fancy-light" type="button" @onclick="ShowUsernamePopup">
            <div class="shine" />
            Tovább →
        </button>
    </div>
</div>

@if (_showUsernamePopup)
{
    <div class="modal-overlay" @onclick="HideUsernamePopup">
        <div class="modal-content" @onclick:stopPropagation="true">

            <div class="modal-text">
                <h1>Válassz felhasználónevet!</h1>
                <p>Ezzel a névvel vesszük fel a játékvégi eredményeidet rangsorba. Óvakodj a határozatlanságtól: a nevedet nem változtathatod meg többé.</p>
            </div>

            <EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit" style="width: 100%;">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <InputText id="username" class="form-control"
                               @bind-Value="_model.Username"
                               placeholder="Írd ide a neved..."
                               maxlength="32"
                               @oninput="OnUsernameInput"
                               style="box-sizing: border-box; width: 100%; padding: 10px 20px; background: var(--powder-50); border: 1px solid var(--cobalt-500); box-shadow: 0px 5px 0px var(--cobalt-500); border-radius: 15px; font-weight: 600; font-size: 1.2em; margin-bottom: 5px; cursor: url(src/Cursors/cursor-text.svg), text;" />
                    <div class="validation-message-container">
                        <ValidationMessage For="@(() => _model.Username)" />
                    </div>
                </div>

                <div class="modal-buttons">
                    <button type="button" @onclick="HideUsernamePopup">Mégse</button>
                    <button type="submit" class="fancy-light" disabled="@(_isSubmitting || !IsUsernameEntered)">
                        <div class="shine" />
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span class="ms-2">Készülj a kalandra...</span>
                        }
                        else
                        {
                            <span>Mehet!</span>
                        }
                    </button>
                </div>
            </EditForm>

        </div>
    </div>
}

@code {
    private readonly CharacterSetupModel _model = new();
    private readonly EditContext _editContext;
    private readonly ValidationMessageStore _messages;

    public CharacterSetup()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
    }

    private bool _isSubmitting;
    private bool _showUsernamePopup;

    private int CurrentIndex { get; set; } = 0;
    private CharacterData CurrentCharacter => Characters[CurrentIndex];
    private Stats PreviewStats => Stats.GetDefault(_model.Level, CurrentCharacter.Gender, CurrentCharacter.Age);

    private bool IsUsernameEntered => !string.IsNullOrWhiteSpace(_model.Username);

    private void OnUsernameInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        _model.Username = value;

        _messages.Clear(new FieldIdentifier(_model, nameof(_model.Username)));
        _editContext.NotifyValidationStateChanged();

        StateHasChanged();
    }

    private void PrevCharacter()
    {
        CurrentIndex = (CurrentIndex - 1 + Characters.Count) % Characters.Count;
        _model.Gender = CurrentCharacter.Gender;
        _model.Age = CurrentCharacter.Age;
        UpdateFavicon();
        StateHasChanged();
    }

    private void NextCharacter()
    {
        CurrentIndex = (CurrentIndex + 1) % Characters.Count;
        _model.Gender = CurrentCharacter.Gender;
        _model.Age = CurrentCharacter.Age;
        UpdateFavicon();
        StateHasChanged();
    }

    private async void UpdateFavicon()
    {
        await JS.InvokeVoidAsync("faviconHelper.changeFavicon", CurrentCharacter.IconUrl);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("faviconHelper.changeFavicon", CurrentCharacter.IconUrl);
        }
    }

    private void ShowUsernamePopup()
    {
        _showUsernamePopup = true;
        StateHasChanged();
    }

    private void HideUsernamePopup()
    {
        if (_isSubmitting) return;
        _showUsernamePopup = false;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (_isSubmitting) return;

        _messages.Clear();

        var username = _model.Username?.Trim() ?? string.Empty;

        if (username.Length == 0)
        {
            _messages.Add(new FieldIdentifier(_model, nameof(_model.Username)),
                "Álljon meg a menet! Ez nem maradhat üresen!");
            _editContext.NotifyValidationStateChanged();
            return;
        }

        if (username.Length > 32)
        {
            _messages.Add(new FieldIdentifier(_model, nameof(_model.Username)),
                "A felhasználóneved legfeljebb 32 karakter lehet.");
            _editContext.NotifyValidationStateChanged();
            return;
        }

        var isTaken = !string.IsNullOrEmpty(username) && await GameService.IsUsernameAvailableAsync(username) == false;
        if (isTaken)
        {
            _messages.Add(new FieldIdentifier(_model, nameof(_model.Username)),
                "Ez a felhasználónév már foglalt. Válassz másikat!");
            _editContext.NotifyValidationStateChanged();
            return;
        }

        _isSubmitting = true;

        try
        {
            var (success, player, errorMessage) = await GameService.CreatePlayerAsync(
                username,
                _model.Level,
                CurrentCharacter.Gender,
                CurrentCharacter.Age
            );

            if (success && player is not null)
            {
                await GameState.SetPlayerAsync(player);
                Navigation.NavigateTo("/play");
            }
            else
            {
                _messages.Add(new FieldIdentifier(_model, nameof(_model.Username)),
                    errorMessage ?? "Nem sikerült létrehozni a karaktert. Próbáld újra!");
                _editContext.NotifyValidationStateChanged();
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string FormatEnum(Enum e)
        => string.Join(' ', Regex.Split(e.ToString(), "(?<=.)(?=[A-Z])"));

    private class CharacterSetupModel
    {
        [Required(ErrorMessage = "Álljon meg a menet! Ez nem maradhat üresen!")]
        [StringLength(32, ErrorMessage = "A felhasználóneved legfeljebb 32 karakter lehet.")]
        public string? Username { get; set; }

        [Required]
        public Gender Gender { get; set; } = Gender.Male;

        [Required]
        public Age Age { get; set; } = Age.Young;

        [Required]
        public PlayerLevel Level { get; set; } = PlayerLevel.Doktorandusz;

        public void Reset()
        {
            Username = string.Empty;
            Gender = Gender.Male;
            Age = Age.Young;
            Level = PlayerLevel.Doktorandusz;
        }
    }
}

